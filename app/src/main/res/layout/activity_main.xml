<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:id="@+id/mainColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Five compact icon+label controls, like the mockup's top row. -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="4dp"
            android:paddingTop="2dp"
            android:paddingRight="4dp"
            android:paddingBottom="2dp">

            <Button
                android:id="@+id/flashButton"
                style="@style/TopButton"
                android:layout_weight="1"
                android:contentDescription="@string/flash"
                android:drawableStart="@drawable/ic_flash_off"
                android:maxLines="1"
                android:text="@string/off" />

            <Button
                android:id="@+id/timerButton"
                style="@style/TopButton"
                android:layout_weight="1"
                android:contentDescription="@string/timer"
                android:drawableStart="@drawable/ic_timer"
                android:maxLines="1"
                android:text="@string/off" />

            <Button
                android:id="@+id/rawButton"
                style="@style/TopButton"
                android:layout_weight="1"
                android:contentDescription="@string/raw"
                android:drawableStart="@drawable/ic_raw"
                android:maxLines="1"
                android:text="@string/on" />

            <Button
                android:id="@+id/gridButton"
                style="@style/TopButton"
                android:layout_weight="1"
                android:contentDescription="@string/grid"
                android:drawableStart="@drawable/ic_grid"
                android:maxLines="1"
                android:text="@string/off" />

            <Button
                android:id="@+id/aspectButton"
                style="@style/TopButton"
                android:layout_weight="1"
                android:contentDescription="@string/aspect_ratio"
                android:drawableStart="@drawable/ic_aspect"
                android:maxLines="1"
                android:text="3:4" />
        </LinearLayout>

        <!-- Black stage with the rounded ratio preview centred inside it. -->
        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.rawcam.AspectFrameLayout
                android:id="@+id/previewContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/bg_preview"
                android:clipToOutline="true">

                <TextureView
                    android:id="@+id/viewfinder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.rawcam.GridOverlay
                    android:id="@+id/gridOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <View
                    android:id="@+id/focusRing"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_focus_ring"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/readout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_readout"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxWidth="236dp"
                    android:maxLines="1"
                    android:paddingLeft="8dp"
                    android:paddingTop="5dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="5dp"
                    android:text="ISO --  \u00b7  1/--  \u00b7  AF  \u00b7  Auto"
                    android:textColor="@color/ui_text_dim"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/zoomIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/bg_pill"
                    android:fontFamily="sans-serif-medium"
                    android:paddingLeft="12dp"
                    android:paddingTop="5dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/ui_text"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/captureIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_pill"
                    android:fontFamily="sans-serif-medium"
                    android:paddingLeft="18dp"
                    android:paddingTop="10dp"
                    android:paddingRight="18dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/ui_text"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-light"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="18"
                    android:textColor="@color/white"
                    android:textSize="110sp"
                    android:visibility="gone" />

                <HorizontalScrollView
                    android:id="@+id/lensScroll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_glass_pill"
                    android:clipToPadding="false"
                    android:padding="4dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/lensRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <View
                    android:id="@+id/flashOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:background="@color/white"
                    android:clickable="false"
                    android:importantForAccessibility="no" />
            </com.rawcam.AspectFrameLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/bottomContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/modeRow"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/manualMode"
                    style="@style/ModeTab"
                    android:text="@string/manual_mode" />

                <TextView
                    android:id="@+id/photoMode"
                    style="@style/ModeTab"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/bg_mode_selected"
                    android:text="@string/photo"
                    android:textColor="@color/ui_accent" />

                <TextView
                    android:id="@+id/infoMode"
                    style="@style/ModeTab"
                    android:layout_marginLeft="6dp"
                    android:text="@string/info" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bottomBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="92dp"
                android:orientation="horizontal"
                android:paddingLeft="34dp"
                android:paddingTop="4dp"
                android:paddingRight="34dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:id="@+id/thumbFrame"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_thumb"
                    android:clickable="true"
                    android:clipToOutline="true"
                    android:contentDescription="@string/gallery"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/thumbImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/thumbPlaceholder"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_photo"
                        android:tint="@color/ui_text_dim" />
                </FrameLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/shutterButton"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:background="@drawable/bg_shutter"
                    android:contentDescription="@string/shutter"
                    android:elevation="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/flipButton"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_flip"
                    android:contentDescription="@string/flip_camera"
                    android:elevation="0dp"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_flip"
                    android:stateListAnimator="@null"
                    android:tint="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/toastView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="190dp"
        android:alpha="0"
        android:background="@drawable/bg_toast"
        android:elevation="30dp"
        android:gravity="center"
        android:maxWidth="320dp"
        android:paddingLeft="14dp"
        android:paddingTop="8dp"
        android:paddingRight="14dp"
        android:paddingBottom="8dp"
        android:textColor="@color/ui_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <View
        android:id="@+id/manualScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ui_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/manualSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_sheet"
        android:elevation="24dp"
        android:orientation="vertical"
        android:paddingLeft="22dp"
        android:paddingTop="12dp"
        android:paddingRight="22dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <View
            android:layout_width="42dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_sheet_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/manual_controls"
                android:textColor="@color/ui_text"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/manualClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingLeft="14dp"
                android:paddingTop="7dp"
                android:paddingRight="14dp"
                android:paddingBottom="7dp"
                android:text="@string/close"
                android:textColor="@color/ui_text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/expChip"
                style="@style/SheetChip"
                android:layout_marginRight="6dp"
                android:text="@string/exp" />

            <Button
                android:id="@+id/focusChip"
                style="@style/SheetChip"
                android:layout_marginRight="6dp"
                android:text="@string/focus" />

            <Button
                android:id="@+id/wbChip"
                style="@style/SheetChip"
                android:text="@string/wb" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/raw"
                android:textColor="@color/ui_accent"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/expPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/expAuto"
                    style="@style/SheetChip"
                    android:layout_marginRight="6dp"
                    android:text="@string/auto" />

                <Button
                    android:id="@+id/expManual"
                    style="@style/SheetChip"
                    android:text="@string/manual" />
            </LinearLayout>

            <TextView
                android:id="@+id/isoLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:paddingTop="12dp"
                android:textColor="@color/ui_text_dim"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/isoSeek"
                style="@style/CamSlider" />

            <TextView
                android:id="@+id/shutterLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ui_text_dim"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/shutterSeek"
                style="@style/CamSlider" />

            <TextView
                android:id="@+id/previewNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:text="@string/preview_approximate"
                android:textColor="@color/ui_accent"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/focusPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/focusAuto"
                    style="@style/SheetChip"
                    android:layout_marginRight="6dp"
                    android:text="@string/auto" />

                <Button
                    android:id="@+id/focusManual"
                    style="@style/SheetChip"
                    android:text="@string/manual" />
            </LinearLayout>

            <TextView
                android:id="@+id/focusLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:paddingTop="12dp"
                android:textColor="@color/ui_text_dim"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/focusSeek"
                style="@style/CamSlider"
                android:max="1000" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wbPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:visibility="gone">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/wbPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/wbLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:paddingTop="12dp"
                android:textColor="@color/ui_text_dim"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/wbSeek"
                style="@style/CamSlider"
                android:max="160"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_permission"
        android:elevation="40dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="36dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.18"
            android:paddingBottom="18dp"
            android:text="RAW \u00b7 CAMERA"
            android:textColor="@color/ui_accent"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/camera_permission_title"
            android:textColor="@color/ui_text"
            android:textSize="25sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:paddingTop="14dp"
            android:paddingBottom="26dp"
            android:text="@string/camera_permission_body"
            android:textColor="@color/ui_text_dim"
            android:textSize="14sp" />

        <Button
            android:id="@+id/grantButton"
            style="@style/PrimaryButton"
            android:text="@string/grant_permission" />
    </LinearLayout>

</FrameLayout>
